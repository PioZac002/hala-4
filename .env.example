# The answer desk talks to any provider that speaks the OpenAI chat-completions protocol.
# The key is read by the server only (server/chat.ts) and never reaches the browser.
# Without a key the desk answers from the price list (offline mode) and says so plainly.

# Groq free tier: create a key at https://console.groq.com/keys — no card, 1000 requests a day.
CHAT_API_KEY=gsk_...

# Defaults below; override to move to another provider.
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=openai/gpt-oss-120b
#
# Google Gemini (free tier, no card, 50 requests a day):
# CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_MODEL=gemini-flash-latest
#
# OpenRouter (free models, 50 requests a day):
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
